# Coze API Configuration
COZE_PAT=your_pat_here
COZE_WORKFLOW_ID=7673785423382331442

# OpenAI Configuration (optional, for text translation)
OPENAI_API_KEY=your_openai_key_here
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_TEXT_MODEL=deepseek-chat

# Server Configuration
PORT=8000

# 认证必填：JWT 签名密钥与飞书不可用时的兜底管理员密码（留空则服务无法启动）
RHC_SECRET_KEY=
RHC_FALLBACK_ADMIN_PASSWORD=

# Feishu (Lark) Bitable Configuration
# 自建应用凭证（开放平台 -> 开发者后台 -> 应用凭证）
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=your_feishu_app_secret
# 多维表格 app_token（多维表 URL 中 /base/ 后的那段）
FEISHU_APP_TOKEN=your_bitable_app_token
# 产品数据表 table_id（登录账号表「系统账号」会自动创建，无需配置 table_id）
FEISHU_TABLE_ID=your_products_table_id